# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for Preview/Production.
# Never commit real values: .env* files are git-ignored.

# Google Tag Manager container ID. Public by design (it ships in the HTML).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Where form submissions are sent. Leave empty locally to write to data/submissions.json.
# Example: a Google Apps Script web-app URL that appends rows to a Google Sheet (see README).
FORM_WEBHOOK_URL=
# Shared secret the webhook checks, so random callers can't write to the sheet.
FORM_WEBHOOK_SECRET=

# Bearer token for GET /api/newsletter outside local dev (lists stored submissions).
ADMIN_TOKEN=

# Keystatic in production (GitHub mode). Leave empty to use local mode.
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=owner/repo
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
